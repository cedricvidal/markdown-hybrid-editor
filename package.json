{
  "name": "markdown-hybrid-editor",
  "displayName": "Markdown Hybrid Editor",
  "description": "Hybrid markdown editing: markup hides on every line the caret is not on, so a note reads like prose but edits like source.",
  "version": "0.0.1",
  "license": "MIT",
  "author": {
    "name": "Cedric Vidal",
    "email": "cedric.vidal@gmail.com"
  },
  "publisher": "cedricvidal",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "live preview",
    "wysiwyg",
    "obsidian",
    "codemirror"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownHybridEditor.editor",
        "displayName": "Markdown Hybrid Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markdownHybridEditor.openWithTextEditor",
        "title": "Reopen in Text Editor",
        "category": "Markdown Hybrid",
        "icon": "$(code)"
      },
      {
        "command": "markdownHybridEditor.openWithHybrid",
        "title": "Reopen in Hybrid Editor",
        "category": "Markdown Hybrid",
        "icon": "$(book)"
      },
      {
        "command": "markdownHybridEditor.toggleFrontmatter",
        "title": "Toggle Frontmatter",
        "category": "Markdown Hybrid"
      },
      {
        "command": "markdownHybridEditor.toggleLivePreview",
        "title": "Toggle Live Preview",
        "category": "Markdown Hybrid"
      },
      {
        "command": "markdownHybridEditor.find",
        "title": "Find",
        "category": "Markdown Hybrid"
      },
      {
        "command": "markdownHybridEditor.replace",
        "title": "Replace",
        "category": "Markdown Hybrid"
      },
      {
        "command": "markdownHybridEditor.findNext",
        "title": "Find Next",
        "category": "Markdown Hybrid"
      },
      {
        "command": "markdownHybridEditor.findPrevious",
        "title": "Find Previous",
        "category": "Markdown Hybrid"
      },
      {
        "command": "markdownHybridEditor.goToHeading",
        "title": "Go to Heading…",
        "category": "Markdown Hybrid"
      },
      {
        "command": "markdownHybridEditor.goToLine",
        "title": "Go to Line…",
        "category": "Markdown Hybrid"
      },
      {
        "command": "markdownHybridEditor.noop",
        "title": "No-op (internal)",
        "category": "Markdown Hybrid",
        "enablement": "false"
      },
      {
        "command": "markdownHybridEditor.showFrontmatter",
        "title": "Show Frontmatter",
        "category": "Markdown Hybrid",
        "icon": "$(symbol-property)"
      },
      {
        "command": "markdownHybridEditor.hideFrontmatter",
        "title": "Hide Frontmatter",
        "category": "Markdown Hybrid",
        "icon": "$(symbol-property)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownHybridEditor.showFrontmatter",
          "when": "activeCustomEditorId == markdownHybridEditor.editor && !markdownHybridEditor.frontmatterVisible",
          "group": "navigation@0"
        },
        {
          "command": "markdownHybridEditor.hideFrontmatter",
          "when": "activeCustomEditorId == markdownHybridEditor.editor && markdownHybridEditor.frontmatterVisible",
          "group": "navigation@0"
        },
        {
          "command": "markdownHybridEditor.openWithTextEditor",
          "when": "activeCustomEditorId == markdownHybridEditor.editor",
          "group": "navigation@1"
        },
        {
          "command": "markdownHybridEditor.openWithHybrid",
          "when": "resourceLangId == markdown && !activeCustomEditorId",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownHybridEditor.openWithTextEditor",
          "when": "activeCustomEditorId == markdownHybridEditor.editor"
        },
        {
          "command": "markdownHybridEditor.openWithHybrid",
          "when": "resourceLangId == markdown && !activeCustomEditorId"
        },
        {
          "command": "markdownHybridEditor.toggleFrontmatter",
          "when": "activeCustomEditorId == markdownHybridEditor.editor"
        },
        {
          "command": "markdownHybridEditor.toggleLivePreview",
          "when": "activeCustomEditorId == markdownHybridEditor.editor"
        },
        {
          "command": "markdownHybridEditor.goToHeading",
          "when": "activeCustomEditorId == markdownHybridEditor.editor"
        },
        {
          "command": "markdownHybridEditor.goToLine",
          "when": "activeCustomEditorId == markdownHybridEditor.editor"
        },
        {
          "command": "markdownHybridEditor.showFrontmatter",
          "when": "false"
        },
        {
          "command": "markdownHybridEditor.hideFrontmatter",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Hybrid Editor",
      "properties": {
        "markdownHybridEditor.typography": {
          "type": "string",
          "enum": [
            "reading",
            "vscode"
          ],
          "enumDescriptions": [
            "A reading column: serif body text, a capped line length and a heading scale.",
            "The editor's own font and full width, matching the rest of VS Code."
          ],
          "default": "reading",
          "description": "How note text is set."
        },
        "markdownHybridEditor.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "Font family for note text. Empty uses the `#markdownHybridEditor.typography#` default."
        },
        "markdownHybridEditor.fontSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 6,
          "markdownDescription": "Font size in pixels for note text. `null` uses the `#markdownHybridEditor.typography#` default."
        },
        "markdownHybridEditor.lineHeight": {
          "type": "number",
          "default": 1.6,
          "minimum": 1,
          "description": "Line height for note text, as a multiple of the font size."
        },
        "markdownHybridEditor.readingMeasure": {
          "type": "string",
          "default": "68ch",
          "markdownDescription": "Maximum line length in reading typography, as a CSS length. Use `none` for full width."
        },
        "markdownHybridEditor.frontmatter.collapsedByDefault": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Fold the YAML frontmatter block behind a one-row summary. This is a single global preference: the toggle command and the strip both write it, so it applies to every open hybrid editor at once."
        },
        "markdownHybridEditor.livePreview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Hide markdown marks on every line the caret is not on. Turn off to always see raw markdown."
        },
        "markdownHybridEditor.tables.render": {
          "type": "boolean",
          "default": true,
          "description": "Render GFM tables as tables, editable cell by cell. Turn off to edit them as markdown."
        },
        "markdownHybridEditor.maxFileSize": {
          "type": "number",
          "default": 1500000,
          "minimum": 10000,
          "markdownDescription": "Documents larger than this many characters open with a notice instead of the hybrid editor. Hiding markup and rendering tables means re-reading the whole document as you type."
        }
      }
    },
    "keybindings": [
      {
        "command": "markdownHybridEditor.toggleFrontmatter",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      },
      {
        "command": "markdownHybridEditor.toggleLivePreview",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      },
      {
        "command": "markdownHybridEditor.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      },
      {
        "command": "markdownHybridEditor.replace",
        "key": "ctrl+h",
        "mac": "cmd+alt+f",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      },
      {
        "command": "markdownHybridEditor.findNext",
        "key": "f3",
        "mac": "cmd+g",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      },
      {
        "command": "markdownHybridEditor.findPrevious",
        "key": "shift+f3",
        "mac": "cmd+shift+g",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      },
      {
        "command": "markdownHybridEditor.goToHeading",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      },
      {
        "command": "markdownHybridEditor.goToLine",
        "key": "ctrl+g",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      },
      {
        "command": "markdownHybridEditor.noop",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      },
      {
        "command": "markdownHybridEditor.noop",
        "key": "alt+up",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      },
      {
        "command": "markdownHybridEditor.noop",
        "key": "alt+down",
        "when": "activeCustomEditorId == markdownHybridEditor.editor"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.webview.json",
    "package": "pnpm typecheck && pnpm build && vsce package --no-dependencies",
    "demo:smoke": "node demo/smoke.mjs",
    "demo:m2": "node demo/m2.mjs",
    "demo:web": "node demo/web.mjs",
    "dev:web": "vscode-test-web --extensionDevelopmentPath=. --folder-uri=memfs:/sample",
    "demo:m3": "node demo/m3.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:m4": "node demo/m4.mjs",
    "demo:m5": "node demo/m5.mjs",
    "demo:gates": "node demo/smoke.mjs && node demo/m2.mjs && node demo/m3.mjs && node demo/m4.mjs && node demo/m5.mjs && node demo/security.mjs && node demo/web.mjs",
    "lint": "eslint .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "demo:security": "node demo/security.mjs",
    "demo:record": "node demo/record.mjs",
    "demo:video": "bash demo/build-video.sh",
    "demo:gif": "bash demo/build-gif.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/vscode": "~1.90.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3"
  },
  "browser": "./dist/extension.web.js",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
