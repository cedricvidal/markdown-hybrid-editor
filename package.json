{
  "name": "markdown-hybrid-editor",
  "displayName": "Markdown Hybrid Editor",
  "description": "Hybrid markdown editing: markup hides on every line the caret is not on, so a note reads like prose but edits like source.",
  "version": "0.0.1",
  "license": "MIT",
  "author": {
    "name": "Cedric Vidal",
    "email": "cedric.vidal@gmail.com"
  },
  "publisher": "cedricvidal",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "live preview",
    "wysiwyg",
    "obsidian",
    "codemirror"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownHybridEditor.editor",
        "displayName": "Markdown Hybrid Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markdownHybridEditor.openWithTextEditor",
        "title": "Reopen in Text Editor",
        "category": "Markdown Hybrid",
        "icon": "$(code)"
      },
      {
        "command": "markdownHybridEditor.openWithHybrid",
        "title": "Reopen in Hybrid Editor",
        "category": "Markdown Hybrid",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownHybridEditor.openWithTextEditor",
          "when": "activeCustomEditorId == markdownHybridEditor.editor",
          "group": "navigation@1"
        },
        {
          "command": "markdownHybridEditor.openWithHybrid",
          "when": "resourceLangId == markdown && !activeCustomEditorId",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownHybridEditor.openWithTextEditor",
          "when": "activeCustomEditorId == markdownHybridEditor.editor"
        },
        {
          "command": "markdownHybridEditor.openWithHybrid",
          "when": "resourceLangId == markdown && !activeCustomEditorId"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Hybrid Editor",
      "properties": {
        "markdownHybridEditor.typography": {
          "type": "string",
          "enum": [
            "reading",
            "vscode"
          ],
          "enumDescriptions": [
            "A reading column: serif body text, a capped line length and a heading scale.",
            "The editor's own font and full width, matching the rest of VS Code."
          ],
          "default": "reading",
          "description": "How note text is set."
        },
        "markdownHybridEditor.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "Font family for note text. Empty uses the `#markdownHybridEditor.typography#` default."
        },
        "markdownHybridEditor.fontSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 6,
          "markdownDescription": "Font size in pixels for note text. `null` uses the `#markdownHybridEditor.typography#` default."
        },
        "markdownHybridEditor.lineHeight": {
          "type": "number",
          "default": 1.6,
          "minimum": 1,
          "description": "Line height for note text, as a multiple of the font size."
        },
        "markdownHybridEditor.readingMeasure": {
          "type": "string",
          "default": "68ch",
          "markdownDescription": "Maximum line length in reading typography, as a CSS length. Use `none` for full width."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.webview.json",
    "package": "pnpm typecheck && pnpm build && vsce package --no-dependencies",
    "demo:smoke": "node demo/smoke.mjs",
    "demo:m2": "node demo/m2.mjs",
    "demo:web": "node demo/web.mjs",
    "dev:web": "vscode-test-web --extensionDevelopmentPath=. --folder-uri=memfs:/sample"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "~1.90.0",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3"
  },
  "browser": "./dist/extension.web.js",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
